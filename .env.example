# =============================================================================
# AXIOMA BACKEND ENVIRONMENT VARIABLES (.env.example)
# Salin berkas ini menjadi `.env` di folder backend atau atur di dashboard
# hosting backend (Railway / Render / Fly.io / VPS).
# RAHASIA: Jangan pernah membagikan SUPABASE_SERVICE_KEY atau GEMINI_API_KEY!
# =============================================================================

# Port server Express & mode environment ("development" | "production")
PORT=8000
NODE_ENV=production

# Jumlah hop reverse proxy di depan Express (1 untuk Railway/Render/Nginx/Cloudflare)
# agar req.ip membaca alamat IP asli pengunjung untuk rate limiting per-IP.
TRUST_PROXY=1

# Daftar origin frontend yang diizinkan oleh CORS (pisahkan dengan koma, tanpa spasi/slash akhir)
# Backend secara otomatis membaca ALLOWED_ORIGINS, FRONTEND_URL, dan NEXT_PUBLIC_APP_URL.
# Domain resmi https://axioma.my.id, https://www.axioma.my.id, dan https://axioma-fe.vercel.app sudah diizinkan secara default.
# Di mode development, http://localhost:3000 otomatis diizinkan.
FRONTEND_URL=https://axioma.my.id
ALLOWED_ORIGINS=https://axioma.my.id,https://www.axioma.my.id,https://axioma-fe.vercel.app,https://axioma.id,https://www.axioma.id

# Kredensial Supabase (Gunakan Service Role Key HANYA di backend)
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Anon key opsional di backend hanya untuk menjalankan skrip `npm run verify:rls`
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Kredensial Isolasi Testing (Opsional namun sangat direkomendasikan):
# Arahkan pengujian otomatis (test:auth, test:attachments:full, test:cloudflare)
# ke project Supabase pengujian/staging terpisah agar data uji tidak mencemari database produksi.
# KEAMANAN: Seluruh skrip pengujian akan otomatis MENOLAK berjalan jika:
# 1. NODE_ENV disetel ke "production"
# 2. SUPABASE_URL_TEST bernilai sama persis dengan SUPABASE_URL produksi
# SUPABASE_URL_TEST=https://test-project-id.supabase.co
# SUPABASE_SERVICE_KEY_TEST=sb_secret_test_here

# Kunci API Google Gemini
GEMINI_API_KEY=your-google-gemini-api-key-here

# Batas maksimum panggilan global ke Gemini API per hari (reset setiap pukul 00:00 UTC)
# Jika tercapai, server mengembalikan HTTP 503 berbahasa Indonesia.
GEMINI_DAILY_CALL_LIMIT=500

# Konfigurasi Rate Limiting pesan (jendela waktu dalam milidetik)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_USER=20
RATE_LIMIT_MAX_PER_IP=25

# (Opsional) DSN Sentry untuk pelaporan error terpusat di produksi
# Format: https://<public_key>@<host>/<project_id>
SENTRY_DSN=

# =============================================================================
# INTEGRASI CLOUDFLARE (PRODUKSI)
# =============================================================================
# Secret origin lock: jika diisi, semua request harus membawa header X-Origin-Secret
# yang dicocokkan dengan nilai ini (ditambahkan oleh Cloudflare Transform Rule),
# kecuali endpoint /health dan /api/health.
CF_ORIGIN_SECRET=your-cloudflare-origin-secret-token-here

# Secret Key Cloudflare Turnstile (Anti-Bot):
# Digunakan backend untuk memverifikasi token dari frontend via https://challenges.cloudflare.com/turnstile/v0/siteverify.
# Kosongkan di development untuk melewati verifikasi anti-bot secara aman.
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key-here

# =============================================================================
# MODE SUARA (VOICE MODE & DIKTE) - STT & TTS
# =============================================================================
# Provider Speech-to-Text ("groq" | "openai" | "deepgram" | "gemini")
# Default: auto-detect (jika GROQ_API_KEY terisi pakai groq, dst. Fallback otomatis ke Gemini jika hanya GEMINI_API_KEY yang tersedia).
STT_PROVIDER=gemini

# Provider Text-to-Speech ("openai" | "elevenlabs" | "google" | "free-google")
# Default: auto-detect (jika OPENAI_API_KEY terisi pakai openai, dst. Fallback otomatis ke free-google tanpa perlu API key tambahan).
TTS_PROVIDER=free-google

# Kunci API Opsional untuk Suara yang Lebih Natural / Lebih Cepat:
# Groq Whisper (sangat cepat & akurat untuk bahasa Indonesia): https://console.groq.com
GROQ_API_KEY=
# OpenAI (Whisper-1 untuk STT, TTS-1 suara nova/alloy untuk TTS): https://platform.openai.com
OPENAI_API_KEY=
# ElevenLabs Multilingual TTS: https://elevenlabs.io
ELEVENLABS_API_KEY=
# Google Cloud Text-to-Speech:
GOOGLE_TTS_API_KEY=

